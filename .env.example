# ===================================
# NOCHILL ContentOS - MVP Environment Variables
# ===================================

# -----------------
# AI Content Studio (REQUIRED for core feature)
# -----------------
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------
# Database (Optional - for cloud sync)
# -----------------
# Get these from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------
# Authentication (Coming in Phase 2)
# -----------------
# Get these from https://clerk.com/
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
# CLERK_SECRET_KEY=sk_test_your-key-here

# -----------------
# Payments (Coming in Phase 2)
# -----------------
# Get these from https://stripe.com/
# STRIPE_SECRET_KEY=sk_test_your-key-here
# STRIPE_WEBHOOK_SECRET=whsec_your-key-here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# -----------------
# Application Settings
# -----------------
NODE_ENV=development
